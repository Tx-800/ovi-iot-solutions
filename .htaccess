# Generated by tools/build-headers.js. Edit that file, not this one.
# Apache / cPanel. Upload the CONTENTS of dist/ (this file included) to public_html.

ErrorDocument 404 /404.html
Options -Indexes

<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' https://cdn.jsdelivr.net 'sha256-nUkrTkGKfaVtvG4+FBKQo1ryu0FbxsGeGy5dlyT6kHs='; img-src 'self' https://cdn.jsdelivr.net https://tile.openstreetmap.org; font-src 'self'; connect-src 'self' https://api.web3forms.com; form-action 'self' https://api.web3forms.com; manifest-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
  Header always set X-Frame-Options "DENY"
</IfModule>

# Older Apache builds do not know these types; a wrong type breaks nosniff.
AddType application/manifest+json .webmanifest
AddType image/webp .webp
AddType font/woff2 .woff2
AddType text/javascript .js

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml application/manifest+json application/xml text/plain
</IfModule>
